<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".Practical25">
    <ImageView
        android:layout_marginTop="-300dp"
        android:id="@+id/loadingCircle"
        android:layout_width="160dp"
        android:layout_height="170dp"
        android:outlineSpotShadowColor="#AC11C7"
        android:contentDescription="@string/rotating_wheel_animation"
        android:src="@drawable/loading_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loadingCircle">
        <Button
            android:id="@+id/startButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:textSize="24sp"
            android:text="@string/start"
            android:textColor="#FFFFFF"
            android:textColorHighlight="#12D1A2"
            android:backgroundTint="#444444" />
        <Button
            android:id="@+id/stopButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:textSize="24sp"
            android:textColorHighlight="#D07D0F"
            android:text="@string/stop"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>